{
  "name": "langfuse-observer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp fmt --check && vp lint --deny-warnings && vp check --no-fmt --no-lint && bun test",
    "check:fix": "vp check --fix",
    "dev": "bun --env-file=.env --watch src/main.ts",
    "format": "vp fmt",
    "lint": "vp lint --deny-warnings",
    "start": "bun --env-file=.env src/main.ts",
    "test": "bun test",
    "typecheck": "vp check --no-fmt --no-lint"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "1.3.14",
    "vite-plus": "0.3.1"
  },
  "engines": {
    "bun": ">=1.3.14 <2",
    "node": ">=24.11 <25"
  },
  "packageManager": "bun@1.3.14"
}
